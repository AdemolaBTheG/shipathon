{
  "cli": {
    "version": ">= 18.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_NO_DEPLOY": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appName": "Video Game Tracker - Joylogue",
        "metadataPath": "./store.config.json"
      }
    }
  }
}
