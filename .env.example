# Server-only credentials used by app/api/games/search+api.ts
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
GEMINI_API_KEY=your_gemini_api_key
LINK_RESOLVER_URL=https://resolver.joylogue.app
LINK_RESOLVER_TOKEN=generate_a_long_random_token

# Public Supabase connection values. The publishable key is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_key
EXPO_PUBLIC_SHARE_ORIGIN=https://joylogue.app

# Public API origin used by native builds. Leave empty for web-relative API routes.
EXPO_PUBLIC_API_URL=https://your-project.expo.app

# Public OneSignal application identifier used by the native push SDK.
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id

# Server-only OneSignal credentials used by friend notification API routes.
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_app_api_key

# Public PostHog configuration embedded in Expo builds.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat public iOS SDK key. Production builds require an appl_ key.
EXPO_RC_APPLE_API_KEY=appl_your_revenuecat_ios_sdk_key
